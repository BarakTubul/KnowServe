# Build-time API base URL. Default /api (same-origin proxy). VITE_* values are public: never put secrets here.
VITE_API_BASE_URL=/api
# Public Firebase web config (not secrets). Local builds point at the Auth Emulator (docs/contracts/auth-session.md).
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-knowserve
VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099
