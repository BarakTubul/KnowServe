{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "json": {"()": "knowserve_core.logging.JsonFormatter", "service": "api"}
  },
  "handlers": {
    "stdout": {"class": "logging.StreamHandler", "stream": "ext://sys.stdout", "formatter": "json"}
  },
  "loggers": {
    "uvicorn": {"handlers": ["stdout"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"handlers": ["stdout"], "level": "INFO", "propagate": false}
  }
}
