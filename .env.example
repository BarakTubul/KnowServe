# Copy to .env for local use. .env is git-ignored. Every value below is a local-only placeholder.
# Production values live in Google Secret Manager (INFRA-07); never commit real values.
# Contract: docs/contracts/config-and-deploy.md

KS_ENV=local
KS_LOG_LEVEL=INFO
# Host port 5433 is the compose db service. Inside compose the services use db:5432.
KS_DATABASE_URL=postgresql+asyncpg://knowserve:knowserve_local_only@localhost:5433/knowserve
# Database used by the automated tests (its schema is dropped and recreated).
KS_TEST_DATABASE_URL=postgresql+asyncpg://knowserve:knowserve_local_only@localhost:5433/knowserve_test

# API
KS_API_ALLOWED_ORIGINS=http://localhost:5173
# Spike-only endpoints for the M0 same-site check (M0-08). Keep false except during the spike.
KS_ENABLE_SPIKE_ENDPOINTS=false
# Same-origin proxy secret (docs/contracts/proxy.md). Unset locally = guard off. Required in production.
KS_PROXY_SHARED_SECRET=

# QStash (Worker verifies deliveries; API/Worker publish). Empty locally: tests use fakes.
# The URL is region specific: copy QSTASH_URL from the Upstash console (EU: https://qstash-eu-central-1.upstash.io).
# The app reads only KS_-prefixed names; copy console QSTASH_TOKEN / *_SIGNING_KEY values into the KS_ keys.
KS_QSTASH_URL=https://qstash.upstash.io
KS_QSTASH_TOKEN=
KS_QSTASH_CURRENT_SIGNING_KEY=local-only-qstash-current-key-not-a-secret
KS_QSTASH_NEXT_SIGNING_KEY=local-only-qstash-next-key-not-a-secret
KS_WORKER_PUBLIC_URL=http://localhost:8001

# Outbox recovery dispatcher authentication.
# production: Google OIDC token from Cloud Scheduler (audience + service account below).
KS_DISPATCHER_OIDC_AUDIENCE=
KS_DISPATCHER_OIDC_SERVICE_ACCOUNT=
# local/ci only; the settings validator refuses this key when KS_ENV=production.
KS_DISPATCHER_LOCAL_TOKEN=local-only-dispatcher-token-not-a-secret

KS_OUTBOX_LEASE_SECONDS=60
KS_OUTBOX_BATCH_SIZE=20
KS_JOB_LEASE_SECONDS=120

# Frontend (Vite)
VITE_API_BASE_URL=/api
