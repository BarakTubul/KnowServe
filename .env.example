# Copy to .env for local use. .env is git-ignored. Every value below is a local-only placeholder.
# Production values live in Google Secret Manager (INFRA-07); never commit real values.
# Contract: docs/contracts/config-and-deploy.md

KS_ENV=local
KS_LOG_LEVEL=INFO
# Host port 5433 is the compose db service. Inside compose the services use db:5432.
KS_DATABASE_URL=postgresql+asyncpg://knowserve:knowserve_local_only@localhost:5433/knowserve
# Database used by the automated tests (its schema is dropped and recreated).
KS_TEST_DATABASE_URL=postgresql+asyncpg://knowserve:knowserve_local_only@localhost:5433/knowserve_test

# API
KS_API_ALLOWED_ORIGINS=http://localhost:5173
# Spike-only endpoints for the M0 same-site check (M0-08). Keep false except during the spike.
KS_ENABLE_SPIKE_ENDPOINTS=false
# Same-origin proxy secret (docs/contracts/proxy.md). Unset locally = guard off. Required in production.
KS_PROXY_SHARED_SECRET=
# Pepper (16+ chars) for the keyed hash of client addresses in rate-limit keys (SEC-18). Required in
# production; empty locally means a random per-process pepper.
KS_IP_HASH_PEPPER=

# QStash (Worker verifies deliveries; API/Worker publish). Empty locally: tests use fakes.
# The URL is region specific: copy QSTASH_URL from the Upstash console (EU: https://qstash-eu-central-1.upstash.io).
# The app reads only KS_-prefixed names; copy console QSTASH_TOKEN / *_SIGNING_KEY values into the KS_ keys.
KS_QSTASH_URL=https://qstash.upstash.io
KS_QSTASH_TOKEN=
KS_QSTASH_CURRENT_SIGNING_KEY=local-only-qstash-current-key-not-a-secret
KS_QSTASH_NEXT_SIGNING_KEY=local-only-qstash-next-key-not-a-secret
KS_WORKER_PUBLIC_URL=http://localhost:8001

# Outbox recovery dispatcher authentication.
# production: Google OIDC token from Cloud Scheduler (audience + service account below).
KS_DISPATCHER_OIDC_AUDIENCE=
KS_DISPATCHER_OIDC_SERVICE_ACCOUNT=
# local/ci only; the settings validator refuses this key when KS_ENV=production.
KS_DISPATCHER_LOCAL_TOKEN=local-only-dispatcher-token-not-a-secret

KS_OUTBOX_LEASE_SECONDS=60
KS_OUTBOX_BATCH_SIZE=20
KS_JOB_LEASE_SECONDS=120
KS_JOB_HANDLER_TIMEOUT_SECONDS=240
KS_JOB_MAX_ATTEMPTS=4
KS_PUBLISH_TIMEOUT_SECONDS=5
KS_PUBLISH_GRACE_SECONDS=120
KS_STUCK_AFTER_SECONDS=2400
# Optional scheduled recovery (off by default) and the isolated-spike operator surface (off).
KS_ENABLE_RECOVERY_DISPATCHER=false
KS_ENABLE_SPIKE_JOB_OPS=false
KS_ENABLE_SPIKE_FAILURE_HOOKS=false
# KS_SPIKE_OPERATOR_EMAILS=
# KS_SPIKE_OIDC_AUDIENCE=

# --- M1 auth (docs/contracts/auth-session.md). All values here are local-only placeholders. ---
# Firebase Auth Emulator (compose service `firebase-auth`, or `npx firebase-tools emulators:start`).
KS_FIREBASE_PROJECT_ID=demo-knowserve
KS_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# Defaults shown; every value is configuration (OPEN-25, OPEN-26). 24 h sessions, 48 h Demo retention.
# KS_SESSION_TTL_SECONDS=86400
# KS_AUTH_MAX_AGE_SECONDS=300
# KS_DEMO_RETENTION_SECONDS=172800
# KS_DEMO_START_LIMIT=5
# KS_QUOTA_DEMO_DAILY=20
# KS_QUOTA_REGISTERED_DAILY=100
# KS_QUOTA_ADMIN_DAILY=100
# KS_AI_GLOBAL_DAILY_QUOTA=100
# KS_AI_KILL_SWITCH=false
# One Admin (AUTH-04): the Firebase uid and email, set only when running the provisioning command.
# KS_ADMIN_FIREBASE_UID=
# KS_ADMIN_EMAIL=
# M2 documents. Local development uses the filesystem store; tests use `fake`; production `r2`.
# KS_OBJECT_STORE=filesystem
# KS_OBJECT_STORE_PATH=.local/objects
# KS_R2_ENDPOINT=
# KS_R2_BUCKET=
# KS_R2_ACCESS_KEY_ID=
# KS_R2_SECRET_ACCESS_KEY=
# KS_DOCUMENTS_PAGE_DEFAULT=20
# KS_DOCUMENTS_PAGE_MAX=50

# Frontend (Vite)
VITE_API_BASE_URL=/api
# Public Firebase web config (not secrets). Local builds point at the emulator.
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-knowserve
VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099

# --- M3 upload and ingestion (defaults are the Owner-approved limits, OPEN-31 D1) ---
# KS_UPLOADS_ENABLED=true
# KS_UPLOAD_MAX_PDF_BYTES=20971520
# KS_UPLOAD_MAX_PDF_PAGES=300
# KS_UPLOAD_MAX_ZIP_BYTES=26214400
# KS_UPLOAD_MAX_ZIP_FILES=20
# KS_UPLOAD_MAX_ZIP_UNCOMPRESSED_BYTES=104857600
# KS_UPLOAD_MAX_ZIP_RATIO=20
# KS_UPLOAD_MAX_MANIFEST_BYTES=262144
# KS_UPLOAD_MAX_IN_FLIGHT=10
# KS_UPLOAD_MAX_PER_DAY=50
# KS_CHUNK_SIZE_TOKENS=512
# KS_CHUNK_OVERLAP_TOKENS=64
# `fake` gives deterministic vectors for local work and tests; production refuses it.
KS_EMBEDDING_PROVIDER=fake
# KS_EMBEDDING_MODEL=text-embedding-3-small
# KS_EMBEDDING_DIMENSIONS=1536
# KS_EMBEDDING_BATCH_SIZE=64
# KS_EMBEDDING_TIMEOUT_SECONDS=30
# KS_OPENAI_API_KEY=
# KS_PDF_EXTRACTION_TIMEOUT_SECONDS=120
# KS_SSE_KEEPALIVE_SECONDS=15
# KS_SSE_MAX_SECONDS=120
