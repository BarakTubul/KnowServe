# Placeholders only. Copy to terraform.tfvars (git-ignored). Never put secret values here.
project_id = "REPLACE_PROJECT_ID"
region     = "europe-west1"

# Exactly one origin: https://<pages_project_name>.pages.dev (no wildcard).
# The first apply must confirm the real pages.dev host equals this value.
api_allowed_origins = ["https://knowserve-m0-spike.pages.dev"]
qstash_url          = "https://REPLACE_QSTASH_BASE_URL"

github_repository = "REPLACE_OWNER/REPLACE_REPO"
github_repository_id       = "REPLACE_GITHUB_REPOSITORY_ID"   # not secret: gh api repos/OWNER/NAME --jq .id
github_repository_owner_id = "REPLACE_GITHUB_OWNER_ID"   # not secret: gh api repos/OWNER/NAME --jq .owner.id
github_environment         = "production"  # "spike" for the M0 spike project

# GCP billing budgets are configured manually by the user; Terraform does not manage them.

cloudflare_account_id   = "REPLACE_CLOUDFLARE_ACCOUNT_ID"
pages_project_name      = "knowserve-m0-spike"
pages_production_branch = "REPLACE_BRANCH"

# Cloud Run API URL (plain Pages variable API_ORIGIN). Placeholder until the first apply shows output api_url.
api_origin = "https://api.example.invalid"

# M2 document storage: the private R2 bucket is created by hand (Q10). Endpoint and bucket are not secrets;
# the R2 token and the IP-hash pepper are secret VERSIONS entered by hand, never here.
r2_endpoint = "https://REPLACE_R2_ACCOUNT_ID.r2.cloudflarestorage.com"
r2_bucket   = "REPLACE_R2_BUCKET"

# Required: the Worker's public https URL (QStash destination).
worker_public_url = "https://worker.example.invalid"

# Optional scheduled recovery: disabled by default (M0 recovery is an admin manual retry).
# enable_recovery_scheduler = false
# scheduler_cron            = "REPLACE_CRON"                    # only if enabled
# scheduler_time_zone       = "Etc/UTC"                         # only if enabled
# dispatcher_oidc_audience  = "https://worker.example.invalid"  # only if enabled

# M1 authentication (OPEN-26 D3): the permanent production project hosts Firebase Authentication.
# Public id, not a secret. Becomes KS_FIREBASE_PROJECT_ID on the API.
firebase_project_id = "knowserve-m0-spike"

# Optional non-secret M1 overrides. Leave empty to keep the application defaults.
# api_m1_settings    = { KS_AI_GLOBAL_DAILY_QUOTA = "100" }
# worker_m1_settings = { KS_DEMO_CLEANUP_BATCH_SIZE = "500" }

# M3 Admin upload and ingestion (OPEN-31). The two R2 tokens, the OpenAI key and their Secret
# Manager VERSIONS are entered by hand, never here. All of these are optional.
# uploads_enabled    = true   # D14 stop switch: false answers 503 UPLOADS_DISABLED on upload routes
# api_m3_settings    = {}     # e.g. { KS_UPLOAD_MAX_PDF_BYTES = "20971520" }; empty keeps the D1 defaults
# worker_m3_settings = {}     # e.g. { KS_CHUNK_SIZE_TOKENS = "512" }; KS_EMBEDDING_PROVIDER is not accepted
# Worker sizing (D2, from the M3-00b measurements): concurrency defaults to 1; memory (512 MiB),
# CPU and the 300 s request timeout stay unmanaged. Set the others only after the first large
# document run on Cloud Run (M3-AC23) shows they are needed.
# worker_concurrency             = 1
# worker_memory                  = "1Gi"
# worker_cpu                     = "1"
# worker_request_timeout_seconds = 600
# Alerts (MON-06): off by default. The address goes only in the git-ignored terraform.tfvars.
# enable_m3_alerts = false
# alert_email      = "REPLACE_ALERT_EMAIL"

# Admin provisioning job (D4): true only while the Owner runs it, then back to false and apply.
# enable_admin_seed_job = false

# Spike operator job routes (isolated spike environment only). Keep real emails in the
# git-ignored terraform.tfvars, never in this file.
# enable_spike_job_ops       = false
# enable_spike_failure_hooks = false
# spike_token_creator_emails = ["REPLACE_YOUR_GOOGLE_ACCOUNT_EMAIL"]  # may impersonate ks-spike-operator
